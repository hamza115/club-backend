# ── Server ──
NODE_ENV=development
PORT=5000

# ── MongoDB ──
MONGO_URI=mongodb://localhost:27017/snooker_club

# ── JWT ──
JWT_SECRET=change_this_to_a_strong_random_secret_key
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=change_this_to_another_strong_random_secret_key
JWT_REFRESH_EXPIRE=30d

# ── Bcrypt ──
BCRYPT_SALT_ROUNDS=12

# ── CORS ──
CORS_ORIGIN=http://localhost:5173

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── File Upload ──
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# ── Business ──
DEFAULT_TAX_RATE=0
CLUB_NAME=Cuemaster Elite
CLUB_CURRENCY=PKR